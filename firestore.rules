rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listingId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /listingRequests/{requestId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
