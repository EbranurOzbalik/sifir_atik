rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isModerator() {
      return request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true
        );
    }

    function hasValidListingCoordinates() {
      return (
          !request.resource.data.keys().hasAny(['latitude', 'longitude'])
        ) || (
          request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
      );
    }

    function acceptedRequestMatches(listingId, acceptedRequestId, status) {
      let acceptedRequest = getAfter(
        /databases/$(database)/documents/listingRequests/$(acceptedRequestId)
      );

      return acceptedRequest.data.listingId == listingId
        && acceptedRequest.data.listingOwnerId == request.auth.uid
        && acceptedRequest.data.status == status;
    }

    function hasValidListingLifecycle(listingId) {
      let beforeStatus = resource.data.get('status', 'active');
      let afterStatus = request.resource.data.get('status', 'active');
      let acceptedRequestId = request.resource.data.get('acceptedRequestId', '');

      return (
          beforeStatus == afterStatus
          && (
            (
              afterStatus == 'active'
              && !request.resource.data.keys()
                .hasAny(['acceptedRequestId', 'completedAt'])
            )
            || (
              afterStatus == 'reserved'
              && acceptedRequestId == resource.data.get('acceptedRequestId', '')
              && !request.resource.data.keys().hasAny(['completedAt'])
            )
            || (
              afterStatus == 'completed'
              && acceptedRequestId == resource.data.get('acceptedRequestId', '')
              && request.resource.data.completedAt == resource.data.completedAt
            )
          )
        ) || (
          beforeStatus == 'active'
          && afterStatus == 'reserved'
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status', 'acceptedRequestId'])
          && acceptedRequestId is string
          && acceptedRequestId.size() > 0
          && acceptedRequestMatches(listingId, acceptedRequestId, 'accepted')
        ) || (
          beforeStatus == 'reserved'
          && afterStatus == 'completed'
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status', 'completedAt'])
          && request.resource.data.completedAt is timestamp
          && acceptedRequestId == resource.data.acceptedRequestId
          && acceptedRequestMatches(listingId, acceptedRequestId, 'completed')
        );
    }

    function hasValidRequestStatusTransition(requestId) {
      let beforeStatus = resource.data.status;
      let afterStatus = request.resource.data.status;
      let listing = getAfter(
        /databases/$(database)/documents/listings/$(resource.data.listingId)
      );

      return (
          beforeStatus == 'pending'
          && afterStatus == 'rejected'
        ) || (
          beforeStatus == 'pending'
          && afterStatus == 'accepted'
          && listing.data.get('status', 'active') == 'reserved'
          && listing.data.acceptedRequestId == requestId
        ) || (
          beforeStatus == 'accepted'
          && afterStatus == 'completed'
          && listing.data.get('status', 'active') == 'completed'
          && listing.data.acceptedRequestId == requestId
        );
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.accountType in ['individual', 'organization']
        && request.resource.data.isOrganizationVerified == false
        && request.resource.data.role == 'user'
        && !request.resource.data.keys().hasAny(['isModerator']);
      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'displayName',
              'email',
              'city',
              'contactPersonName',
              'organizationType',
              'accountType',
              'isOrganizationVerified',
              'updatedAt'
            ])
          && (
            request.resource.data.accountType == resource.data.get('accountType', '')
            || (
              !resource.data.keys().hasAny(['accountType'])
              && request.resource.data.accountType in ['individual', 'organization']
            )
          )
          && (
            request.resource.data.isOrganizationVerified ==
              resource.data.get('isOrganizationVerified', false)
            || (
              !resource.data.keys().hasAny(['isOrganizationVerified'])
              && request.resource.data.isOrganizationVerified == false
            )
          )
          && (
            request.resource.data.email == resource.data.get('email', '')
            || !resource.data.keys().hasAny(['email'])
          )
          && request.resource.data.get('role', '') == resource.data.get('role', '')
        ) || (
          isModerator()
          && resource.data.accountType == 'organization'
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['isOrganizationVerified', 'updatedAt'])
        );

      match /devices/{deviceId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
      }

      match /savedListings/{listingId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.listingId == listingId
          && request.resource.data.keys().hasOnly(['listingId', 'savedAt']);
        allow update: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.status == 'active'
        && !request.resource.data.keys()
          .hasAny(['acceptedRequestId', 'completedAt'])
        && request.resource.data.ownerAccountType in ['individual', 'organization']
        && request.resource.data.ownerAccountType ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType
        && hasValidListingCoordinates()
        && (
          request.resource.data.isOwnerVerified == false
          || get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.isOrganizationVerified == true
        );
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerAccountType == resource.data.ownerAccountType
        && request.resource.data.isOwnerVerified == resource.data.isOwnerVerified
        && request.resource.data.get('status', 'active') in ['active', 'reserved', 'completed']
        && hasValidListingCoordinates()
        && hasValidListingLifecycle(listingId);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerId || isModerator());
    }

    match /listingRequests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.requesterId
          || request.auth.uid == resource.data.listingOwnerId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.requesterId
        && request.resource.data.requesterId != request.resource.data.listingOwnerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
          .data.ownerId == request.resource.data.listingOwnerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
          .data.get('status', 'active') == 'active';
      allow update: if request.auth != null
        && request.auth.uid == resource.data.listingOwnerId
        && (
          (
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['status'])
            && request.resource.data.status in ['pending', 'accepted', 'rejected', 'completed']
            && hasValidRequestStatusTransition(requestId)
          )
          || request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'listingTitle',
              'listingAmount',
              'listingLocation',
              'ownerContactInfo'
            ])
        );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.requesterId
          || request.auth.uid == resource.data.listingOwnerId
          || isModerator());
    }

    match /listingReports/{reportId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.reporterId || isModerator());
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.reporterId != request.resource.data.listingOwnerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
          .data.ownerId == request.resource.data.listingOwnerId;
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status'])
        && request.resource.data.status in ['open', 'resolved'];
      allow delete: if isModerator();
    }
  }
}
